Dashboard second_personal_dashboards_saqcm {
  title: 'second personal dashboards'
  owner: 'khai.to@holistics.io'
  block title: TextBlock {
    content: @md # Your title goes here ;;
  }
  block v_iqln: VizBlock {
    label: 'Country Code, Total Users and 4 more'
    viz: DataTable {
      dataset: ecommerce_demo
      fields: [
        VizFieldFull {
          ref: r(ecommerce_countries.code)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_demo.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_demo.active_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_demo.total_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_demo.total_order_items)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_demo.total_quantity)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 910
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 60)
    }
    block v_iqln {
      position: pos(20, 120, 1220, 520)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
  settings {
    autorun_on_open: true
  }
}