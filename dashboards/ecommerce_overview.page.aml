Dashboard ecommerce_overview {
  title: 'Ecommerce Overview'
  description: 'Starter dashboard for @Dataset:ecommerce with one chart.'

  block v1: VizBlock {
    label: 'Monthly Total Orders Trend'
    viz: LineChart {
      dataset: ecommerce
      x_axis: VizFieldFull {
        ref: r(ecommerce_orders.created_at)
        label: 'Order Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Total Orders'
        series {
          field: VizFieldFull {
            ref: r(ecommerce.total_orders)
            label: 'Total Orders'
            format {
              type: 'number'
              pattern: '#,###0.00'
            }
          }
          settings {
            color: '#2563EB'
            line_interpolation: 'linear'
          }
        }
      }
      settings {
        row_limit: 100
        legend_label: 'hidden'
        show_data_points: true
        connect_discontinuous_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v2: VizBlock {
    label: 'Total Orders'
    viz: MetricKpi {
      dataset: ecommerce
      value: VizFieldFull {
        ref: r(ecommerce.total_orders)
        label: 'Total Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        row_limit: 100
        alignment: 'center'
        label {
          font_size: 14
          font_color: '#6B7280'
        }
        metric_value {
          font_size: 36
          font_color: '#111827'
        }
      }
    }
  }

  block v3: VizBlock {
    label: 'Total Users'
    viz: MetricKpi {
      dataset: ecommerce
      value: VizFieldFull {
        ref: r(ecommerce.total_users)
        label: 'Total Users'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        row_limit: 100
        alignment: 'center'
        label {
          font_size: 14
          font_color: '#6B7280'
        }
        metric_value {
          font_size: 32
          font_color: '#111827'
        }
      }
    }
  }

  block v4: VizBlock {
    label: 'GMV'
    viz: MetricKpi {
      dataset: ecommerce
      value: VizFieldFull {
        ref: r(ecommerce.gmv)
        label: 'GMV'
        format {
          type: 'number'
          pattern: '[$]#,###'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        label {
          font_size: 14
          font_color: '#6B7280'
        }
        metric_value {
          font_size: 32
          font_color: '#111827'
        }
      }
    }
  }

  block v5: VizBlock {
    label: 'Delivered Order Rate'
    viz: MetricKpi {
      dataset: ecommerce
      value: VizFieldFull {
        ref: r(ecommerce.delivered_order_rate)
        label: 'Delivered Order Rate'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        label {
          font_size: 14
          font_color: '#6B7280'
        }
        metric_value {
          font_size: 32
          font_color: '#111827'
        }
      }
    }
  }

  view: CanvasLayout {
    label: 'Overview'
    width: 1200
    height: 700
    block v2 {
      position: pos(20, 20, 280, 140)
    }
    block v3 {
      position: pos(320, 20, 280, 140)
    }
    block v4 {
      position: pos(620, 20, 280, 140)
    }
    block v5 {
      position: pos(920, 20, 260, 140)
    }
    block v1 {
      position: pos(20, 190, 1160, 470)
    }
  }
}
