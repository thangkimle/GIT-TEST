Dashboard ecommerce_overview {
  title: 'Ecommerce Overview'
  description: 'Starter dashboard for @Dataset:ecommerce with one chart.'

  block t_slide_1_header: TextBlock {
    content: @md
      <div style="height: 100%; padding: 28px 32px; background: linear-gradient(135deg, #0F172A 0%, #1D4ED8 100%); border-radius: 24px; color: white; box-sizing: border-box;">
        <div style="font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.75; margin-bottom: 10px;">Executive Slide</div>
        <div style="font-size: 42px; line-height: 1.1; font-weight: 800; margin-bottom: 12px;">Ecommerce Overview</div>
        <div style="font-size: 18px; line-height: 1.6; max-width: 760px; opacity: 0.92;">Use the built-in tab navigation to move between slides.</div>
      </div>
    ;;
  }

  block t_slide_1_summary: TextBlock {
    content: @md
      <div style="height: 100%; padding: 28px 32px; background: white; border: 1px solid #E5E7EB; border-radius: 24px; box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08); box-sizing: border-box; color: #0F172A;">
        <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #475569; margin-bottom: 14px;">Slide summary</div>
        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-bottom: 22px;">
          <div style="padding: 18px 20px; border: 1px solid #E2E8F0; border-radius: 18px; background: #F8FAFC;">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; color: #64748B; margin-bottom: 8px;">Total Orders</div>
            <div style="font-size: 34px; font-weight: 800; color: #0F172A;">33,010</div>
          </div>
          <div style="padding: 18px 20px; border: 1px solid #E2E8F0; border-radius: 18px; background: #F8FAFC;">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; color: #64748B; margin-bottom: 8px;">Total Users</div>
            <div style="font-size: 34px; font-weight: 800; color: #0F172A;">10,264</div>
          </div>
          <div style="padding: 18px 20px; border: 1px solid #E2E8F0; border-radius: 18px; background: #F8FAFC;">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; color: #64748B; margin-bottom: 8px;">GMV</div>
            <div style="font-size: 34px; font-weight: 800; color: #0F172A;">$11,581,542</div>
          </div>
          <div style="padding: 18px 20px; border: 1px solid #E2E8F0; border-radius: 18px; background: #F8FAFC;">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; color: #64748B; margin-bottom: 8px;">Delivered Order Rate</div>
            <div style="font-size: 34px; font-weight: 800; color: #0F172A;">70.2%</div>
          </div>
        </div>
        <div style="font-size: 15px; line-height: 1.8; color: #334155;">
          <div><strong>How to navigate:</strong> use the dashboard tabs as slides.</div>
          <div><strong>Slide 2:</strong> Total Orders</div>
          <div><strong>Slide 3:</strong> Total Users</div>
          <div><strong>Slide 4:</strong> GMV</div>
          <div><strong>Slide 5:</strong> Delivered Order Rate and Monthly Total Orders Trend</div>
        </div>
      </div>
    ;;
  }

  block t_slide_2_header: TextBlock {
    content: @md
      <div style="height: 100%; padding: 20px 28px; background: white; border: 1px solid #E5E7EB; border-radius: 20px; box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06); box-sizing: border-box;">
        <div style="font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #64748B; margin-bottom: 6px;">Slide 2</div>
        <div style="font-size: 28px; font-weight: 800; color: #0F172A;">Total Orders</div>
      </div>
    ;;
  }

  block t_slide_3_header: TextBlock {
    content: @md
      <div style="height: 100%; padding: 20px 28px; background: white; border: 1px solid #E5E7EB; border-radius: 20px; box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06); box-sizing: border-box;">
        <div style="font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #64748B; margin-bottom: 6px;">Slide 3</div>
        <div style="font-size: 28px; font-weight: 800; color: #0F172A;">Total Users</div>
      </div>
    ;;
  }

  block t_slide_4_header: TextBlock {
    content: @md
      <div style="height: 100%; padding: 20px 28px; background: white; border: 1px solid #E5E7EB; border-radius: 20px; box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06); box-sizing: border-box;">
        <div style="font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #64748B; margin-bottom: 6px;">Slide 4</div>
        <div style="font-size: 28px; font-weight: 800; color: #0F172A;">GMV</div>
      </div>
    ;;
  }

  block t_slide_5_header: TextBlock {
    content: @md
      <div style="height: 100%; padding: 20px 28px; background: white; border: 1px solid #E5E7EB; border-radius: 20px; box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06); box-sizing: border-box;">
        <div style="font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #64748B; margin-bottom: 6px;">Slide 5</div>
        <div style="font-size: 28px; font-weight: 800; color: #0F172A;">Delivered Order Rate & Monthly Trend</div>
      </div>
    ;;
  }

  block v1: VizBlock {
    label: 'Monthly Total Orders Trend'
    viz: LineChart {
      dataset: ecommerce
      x_axis: VizFieldFull {
        ref: r(ecommerce_orders.created_at)
        label: 'Order Month'
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        label: 'Total Orders'
        series {
          field: VizFieldFull {
            ref: r(ecommerce.total_orders)
            label: 'Total Orders'
            format {
              type: 'number'
              pattern: '#,###0.00'
            }
          }
          settings {
            color: '#2563EB'
            line_interpolation: 'linear'
          }
        }
      }
      settings {
        row_limit: 100
        legend_label: 'hidden'
        show_data_points: true
        connect_discontinuous_points: false
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block v2: VizBlock {
    label: 'Total Orders'
    viz: MetricKpi {
      dataset: ecommerce
      value: VizFieldFull {
        ref: r(ecommerce.total_orders)
        label: 'Total Orders'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        row_limit: 100
        alignment: 'center'
        label {
          font_size: 14
          font_color: '#6B7280'
        }
        metric_value {
          font_size: 36
          font_color: '#111827'
        }
      }
    }
  }

  block v3: VizBlock {
    label: 'Total Users'
    viz: MetricKpi {
      dataset: ecommerce
      value: VizFieldFull {
        ref: r(ecommerce.total_users)
        label: 'Total Users'
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        display_mode: 'single'
        row_limit: 100
        alignment: 'center'
        label {
          font_size: 14
          font_color: '#6B7280'
        }
        metric_value {
          font_size: 32
          font_color: '#111827'
        }
      }
    }
  }

  block v4: VizBlock {
    label: 'GMV'
    viz: MetricKpi {
      dataset: ecommerce
      value: VizFieldFull {
        ref: r(ecommerce.gmv)
        label: 'GMV'
        format {
          type: 'number'
          pattern: '[$]#,###'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        label {
          font_size: 14
          font_color: '#6B7280'
        }
        metric_value {
          font_size: 32
          font_color: '#111827'
        }
      }
    }
  }

  block v5: VizBlock {
    label: 'Delivered Order Rate'
    viz: MetricKpi {
      dataset: ecommerce
      value: VizFieldFull {
        ref: r(ecommerce.delivered_order_rate)
        label: 'Delivered Order Rate'
        format {
          type: 'number'
          pattern: '#,###0.0%'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
        label {
          font_size: 14
          font_color: '#6B7280'
        }
        metric_value {
          font_size: 32
          font_color: '#111827'
        }
      }
    }
  }

  view: HTMLLayout {
    content: @html
      <div style="min-height: 100vh; background: linear-gradient(180deg, #F8FAFC 0%, #EEF2FF 100%); padding: 32px; box-sizing: border-box; font-family: Inter, Arial, sans-serif;">
        <div style="max-width: 1440px; margin: 0 auto; display: grid; gap: 24px;">
          <div style="display: grid; grid-template-columns: 2.2fr 1fr; gap: 20px; align-items: stretch;">
            <div style="background: linear-gradient(135deg, #0F172A 0%, #1D4ED8 100%); border-radius: 24px; padding: 28px 32px; color: white; box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);">
              <div style="font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.75; margin-bottom: 10px;">Executive Slide</div>
              <div style="font-size: 42px; line-height: 1.1; font-weight: 800; margin-bottom: 12px;">Ecommerce Overview</div>
              <div style="font-size: 18px; line-height: 1.6; max-width: 760px; opacity: 0.92;">HTMLLayout version of the slide deck. Since script-based navigation doesn't work, all slides are shown in a vertically stacked presentation flow.</div>
            </div>
            <div style="background: rgba(255,255,255,0.82); border: 1px solid #E2E8F0; border-radius: 24px; padding: 24px 26px; box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);">
              <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #475569; margin-bottom: 12px;">Navigation note</div>
              <div style="font-size: 15px; line-height: 1.8; color: #334155;">
                <div><strong>Constraint:</strong> custom Next / Back isn't available without working script support.</div>
                <div><strong>Fallback:</strong> this HTMLLayout renders each slide as a separate section in order.</div>
                <div><strong>Flow:</strong> Overview → Orders → Users → GMV → Delivery & Trend</div>
              </div>
            </div>
          </div>

          <div style="background: white; border: 1px solid #E5E7EB; border-radius: 24px; padding: 24px; box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);">
            <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #475569; margin-bottom: 14px;">Slide 1 · Overview</div>
            <h-block name="t_slide_1_summary" />
          </div>

          <div style="background: white; border: 1px solid #E5E7EB; border-radius: 24px; padding: 24px; box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);">
            <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #475569; margin-bottom: 14px;">Slide 2 · Total Orders</div>
            <h-block name="v2" />
          </div>

          <div style="background: white; border: 1px solid #E5E7EB; border-radius: 24px; padding: 24px; box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);">
            <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #475569; margin-bottom: 14px;">Slide 3 · Total Users</div>
            <h-block name="v3" />
          </div>

          <div style="background: white; border: 1px solid #E5E7EB; border-radius: 24px; padding: 24px; box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);">
            <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #475569; margin-bottom: 14px;">Slide 4 · GMV</div>
            <h-block name="v4" />
          </div>

          <div style="background: white; border: 1px solid #E5E7EB; border-radius: 24px; padding: 24px; box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);">
            <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #475569; margin-bottom: 14px;">Slide 5 · Delivered Order Rate & Monthly Trend</div>
            <div style="display: grid; grid-template-columns: 360px 1fr; gap: 20px; align-items: start;">
              <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 20px; padding: 12px;">
                <h-block name="v5" />
              </div>
              <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 20px; padding: 12px;">
                <h-block name="v1" />
              </div>
            </div>
          </div>
        </div>
      </div>
    ;;
  }
}
