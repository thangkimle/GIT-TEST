Dashboard lepaya_2 {
  title: 'lepaya'
  description: ''
  owner: 'uyen.nm@holistics.io'
  block title: TextBlock {
    content: @md # Test test test;;
  }
  block v_mwx0: VizBlock {
    label: 'Company, First name and 9 more'
    viz: DataTable {
      dataset: lepaya
      fields: [
        VizFieldFull {
          ref: r(audit_responses_2026_csv.company)
          format {
            type: 'text'
          }
          uname: 'audit_responses_2026_csv_company'
        },
        VizFieldFull {
          ref: r(audit_responses_2026_csv.first_name)
          format {
            type: 'text'
          }
          uname: 'audit_responses_2026_csv_first_name'
        },
        VizFieldFull {
          ref: r(audit_responses_2026_csv.last_name)
          format {
            type: 'text'
          }
          uname: 'audit_responses_2026_csv_last_name'
        },
        VizFieldFull {
          ref: r(audit_responses_2026_csv.program)
          format {
            type: 'text'
          }
          uname: 'audit_responses_2026_csv_program'
        },
        VizFieldFull {
          ref: r(audit_responses_2026_csv.wave)
          format {
            type: 'text'
          }
          uname: 'audit_responses_2026_csv_wave'
        },
        VizFieldFull {
          ref: r(audit_responses_2026_csv.module)
          format {
            type: 'text'
          }
          uname: 'audit_responses_2026_csv_module'
        },
        VizFieldFull {
          ref: r(audit_responses_2026_csv.classroom_starts_at)
          format {
            type: 'datetime'
          }
          uname: 'audit_responses_2026_csv_classroom_starts_at'
        },
        VizFieldFull {
          ref: r(audit_responses_2026_csv.questionnaire)
